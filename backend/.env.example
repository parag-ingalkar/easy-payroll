# Backend Environment Variables for Production
# Copy this file to .env and update with production values

# Database Configuration (REQUIRED)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Security Settings (REQUIRED - generate secure random values)
SECRET_KEY=generate-a-strong-secret-key-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend URLs for CORS (REQUIRED - comma-separated list)
# Include all domains where your frontend will be hosted
# Examples:
#   Development: http://localhost:3000
#   Production: https://myapp.com,https://www.myapp.com
#   Staging: https://staging.myapp.com,http://localhost:3000
FRONTEND_URLS=http://localhost:3000

# Optional: Logging level
LOG_LEVEL=INFO
